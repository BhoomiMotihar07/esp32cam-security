{
  "name": "@esp32cam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file-if-exists=.env src/dev-server.ts",
    "start": "func start",
    "prestart": "npm run build",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.1",
    "@azure/functions": "^4.5.1",
    "@azure/storage-blob": "^12.25.0",
    "@esp32cam/shared": "*",
    "azure-iot-common": "^1.13.3",
    "azure-iothub": "^1.16.5",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/web-push": "^3.6.4",
    "azure-functions-core-tools": "^4.0.6610",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4",
    "esbuild": "^0.24.0"
  }
}
