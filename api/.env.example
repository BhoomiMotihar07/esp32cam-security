# Copy to api/.env (gitignored); `npm run dev -w api` loads it. `func start` reads local.settings.json instead.
# For a real ESP32-CAM on your Wi-Fi, set PUBLIC_API_BASE to http://<this computer's LAN IP>:7071/api.
# Generate push keys with: npx web-push generate-vapid-keys
APP_MODE=local
JWT_SECRET=dev-only-secret-change-me-please
SETUP_CODE=setup-1234
APP_ORIGIN=http://localhost:5173
PUBLIC_API_BASE=http://localhost:7071/api
LOCAL_DATA_DIR=./.data
# Optional in local mode:
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
