# Simulator settings (export before `npm run sim`), or pass flags: --device cam-01 --link local|iothub --api http://localhost:7071/api
SIM_DEVICE_ID=cam-01
SIM_UPLOAD_KEY=dev-upload-key-123
SIM_LINK=local
SIM_API_BASE=http://localhost:7071/api
# IoT Hub link only: `az iot hub device-identity connection-string show -n <hub> -d cam-01`
IOTHUB_DEVICE_CONNECTION_STRING=
